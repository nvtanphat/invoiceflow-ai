FROM python:3.12-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Dependencies first against a placeholder package so source edits keep this layer cached;
# the real package is installed after the sources are copied.
COPY pyproject.toml README.md ./
RUN pip install --no-cache-dir --upgrade pip && \
    mkdir -p src/invoiceflow && touch src/invoiceflow/__init__.py && \
    pip install --no-cache-dir . && \
    rm -rf src

COPY src/ ./src
RUN pip install --no-cache-dir --no-deps --force-reinstall .

COPY migrations/ ./migrations
COPY alembic.ini .

FROM python:3.12-slim AS runner

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 10001 -s /bin/bash appuser

COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
COPY --from=builder /app/migrations /app/migrations
COPY --from=builder /app/alembic.ini /app/alembic.ini

RUN mkdir -p /app/data/storage && chown -R appuser:appuser /app

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health/live || exit 1

CMD ["uvicorn", "invoiceflow.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
