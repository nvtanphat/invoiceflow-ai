{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GroundTruthInvoiceSchema",
  "type": "object",
  "required": ["case_id", "document_type", "header", "lines"],
  "properties": {
    "case_id": { "type": "string" },
    "document_type": { "type": "string", "enum": ["xml_standard", "pdf_digital", "pdf_scan", "discrepancy_price", "discrepancy_qty"] },
    "header": {
      "type": "object",
      "required": ["supplier_tax_id", "invoice_number", "amount_payable"],
      "properties": {
        "supplier_tax_id": { "type": "string" },
        "supplier_name": { "type": "string" },
        "invoice_number": { "type": "string" },
        "invoice_series": { "type": "string" },
        "issue_date": { "type": "string" },
        "currency": { "type": "string" },
        "subtotal": { "type": "string" },
        "tax_total": { "type": "string" },
        "amount_payable": { "type": "string" }
      }
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "qty", "unit_price", "line_amount"],
        "properties": {
          "sku": { "type": ["string", "null"] },
          "description": { "type": "string" },
          "qty": { "type": "string" },
          "unit_price": { "type": "string" },
          "tax_rate": { "type": ["string", "null"] },
          "line_amount": { "type": "string" }
        }
      }
    },
    "expected_discrepancies": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
