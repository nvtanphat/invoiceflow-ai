# Application
APP_NAME=InvoiceFlow AI
APP_ENV=development
API_V1_STR=/api/v1
DEBUG=true

# Security (Replace with strong random values in production)
JWT_SECRET=change-this-to-a-very-secure-random-secret-key-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL default, SQLite for quick local test)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/invoiceflow
# DATABASE_URL=sqlite+aiosqlite:///./invoiceflow.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Redis Broker (for Dramatiq queues)
REDIS_URL=redis://localhost:6379/0

# Object Storage (local filesystem directory or S3/MinIO)
STORAGE_KIND=local
LOCAL_STORAGE_DIR=./data/storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=invoiceflow-documents
S3_REGION=us-east-1

# AI & Document Extractor (openai / gemini)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_or_modelapi_key_here
OPENAI_BASE_URL=https://api.modelapi.vn/v1
OPENAI_MODEL_ID=gpt-6.1-sol

GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash
MAX_PROVIDER_BUDGET_PER_DOC_USD=0.05
REQUEST_TIMEOUT_SECONDS=30

# File Upload Constraints
MAX_UPLOAD_SIZE_BYTES=26214400
MAX_DOCUMENT_PAGES=50

# Worker reliability and review thresholds
# Seconds without a status change after which an in-flight job counts as abandoned.
JOB_LEASE_SECONDS=900
# Engine-reported field confidence below this sends the field to review (UNCERTAIN).
MIN_FIELD_CONFIDENCE=0.70

# OCR (worker). Docling + EasyOCR; scanned pages are re-OCRed in full.
OCR_ENGINE=easyocr
OCR_DPI=200
FORCE_FULL_PAGE_OCR=true
# Longest side (px) OCR may render for uploaded images; larger images are scaled down.
IMAGE_OCR_MAX_SIDE_PX=3500
# Worker container: each OCR process needs ~5 GB RAM.
WORKER_PROCESSES=1
WORKER_THREADS=1

# docker compose only: infrastructure credentials, interpolated into the compose file.
# Required (compose refuses to start without them); use long random values.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=invoiceflow
MINIO_ROOT_PASSWORD=
# Host port of the web UI (nginx serves the SPA and proxies /api to the API).
WEB_PORT=8080
